# ──────────────────────────────────────────────────────────────────────────────
# Fetch frequencies (hours between re-fetches)
# ──────────────────────────────────────────────────────────────────────────────

# How often to re-fetch the section search page for each semester
FETCH_FREQ_SEMESTER_SEARCH=24

# How often to re-fetch the course catalogue for each semester
FETCH_FREQ_SEMESTER_CATALOGUE=168

# How often to re-fetch course attributes for each semester
FETCH_FREQ_SEMESTER_ATTRIBUTES=168

# How often to re-fetch BC Transfer Guide credits per subject
FETCH_FREQ_TRANSFER_CREDITS=48

# How often to re-fetch individual course pages from langara.ca
FETCH_FREQ_LANGARA_COURSE_PAGE=48

# How often to re-run the meta tasks that discover new sources
FETCH_FREQ_DISCOVER_SEMESTERS=24
FETCH_FREQ_DISCOVER_TRANSFER_SUBJECTS=24
FETCH_FREQ_DISCOVER_LANGARA_COURSES=24

# ──────────────────────────────────────────────────────────────────────────────
# Stagger offsets (seconds)
#
# After completing a fetch, the next fetch time is:
#   fetchedAt + frequency + (sourceId % offset)
#
# This spreads re-fetches across a rolling window so 1500+ sources don't all
# re-queue at the exact same moment. First-run fetches are always immediate.
# Set to 0 to disable staggering for a type.
# ──────────────────────────────────────────────────────────────────────────────

FETCH_OFFSET_SEMESTER_SEARCH=7200
FETCH_OFFSET_SEMESTER_CATALOGUE=7200
FETCH_OFFSET_SEMESTER_ATTRIBUTES=7200
FETCH_OFFSET_TRANSFER_CREDITS=3600
FETCH_OFFSET_LANGARA_COURSE_PAGE=3600
